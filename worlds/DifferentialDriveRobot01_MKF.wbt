            appearance Appearance {
              material Material {
              }
              texture ImageTexture {
              }
            }
            geometry Cylinder {
              height 0.05
              radius 0.05
            }
          }
        ]
        boundingObject USE wheel
        physics Physics {
        }
        radarCrossSection 5
      }
    }
    DEF body Pose {
      translation 0 0 0.051
      children [
        Shape {
          appearance PBRAppearance {
            roughness 1
          }
          geometry Box {
            size 0.25 0.25 0.1
          }
        }
      ]
